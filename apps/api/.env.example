API_HOST=127.0.0.1
API_PORT=3000
NODE_ENV=development
TRUST_PROXY=false
LOG_LEVEL=info
LOGIN_RATE_LIMIT=8

# Worker de sauvegarde uniquement. Ne jamais exposer ces valeurs à Vite.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
SUPABASE_BACKUP_BUCKET=double-backups
