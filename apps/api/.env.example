BACKUP_TIMEZONE=UTC
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_WEEKLY_DAY=0
BACKUP_SOURCE_LABEL=railway-production
